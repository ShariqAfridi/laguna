MAIL_ENCRYPTION="ssl"
MAIL_FROM_ADDRESS="noreply@lagunavibe.com"
MAIL_FROM_NAME="Laguna Vibe"
ADMIN_EMAIL="admin@lagunavibe.com"

# FedEx Shipping Configuration
FEDEX_ENVIRONMENT="sandbox"
FEDEX_API_KEY="your_fedex_api_key"
