APP_NAME="Laguna Vibe"
APP_ENV=local
APP_URL="http://localhost/laguna"

DB_HOST="localhost"
DB_USER="root"
DB_PASS=""
DB_NAME="onlifwko_laguna"

# Bank of America Merchant Gateway Configuration
BOA_MERCHANT_ID="your_merchant_id"
BOA_API_KEY_ID="your_api_key_id"
